{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@shavin/ui": ["../packages/ui/src/index.ts"],
      "@shavin/ui/components.json": ["../packages/ui/components.json"],
      "@/*": ["../packages/ui/src/*"]
    }
  },
  "include": ["src", "plugins", "vite.config.ts", "tailwind.config.ts"]
}
