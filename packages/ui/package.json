{
  "name": "@shavin/ui",
  "version": "0.1.0",
  "description": "Token-driven, agent-readable design system and React primitive library",
  "license": "MIT",
  "author": "Avinash Bussa <avinashbussa1@gmail.com>",
  "homepage": "https://docs.shavin.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avinashbussa/shavin.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/avinashbussa/shavin/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "ui-components",
    "tailwind",
    "tailwindcss",
    "radix-ui",
    "design-tokens",
    "accessibility",
    "ai-agents",
    "mcp",
    "shavin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": [
    "*.css"
  ],
  "style": "./dist/styles/global.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./primitives/*": {
      "types": "./src/primitives/*.tsx",
      "import": "./src/primitives/*.tsx",
      "default": "./src/primitives/*.tsx"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "default": "./dist/tailwind-preset.js"
    },
    "./styles.css": "./dist/styles/global.css",
    "./global-oklch.css": "./dist/styles/global-oklch.css",
    "./theme-v4.css": "./dist/styles/theme-v4.css",
    "./theme-v4-oklch.css": "./dist/styles/theme-v4-oklch.css",
    "./styles/*": "./src/styles/*",
    "./styles/global.css": "./src/styles/global.css",
    "./styles/global-oklch.css": "./src/styles/global-oklch.css",
    "./styles/theme-v4-oklch.css": "./src/styles/theme-v4-oklch.css",
    "./styles/brand-tokens.css": "./src/styles/brand-tokens.css",
    "./styles/brand-tokens-oklch.css": "./src/styles/brand-tokens-oklch.css",
    "./styles/brand-preset.mjs": "./src/styles/brand-preset.mjs",
    "./styles/brand-theme-v4.css": "./src/styles/brand-theme-v4.css",
    "./styles/brand-theme-v4-oklch.css": "./src/styles/brand-theme-v4-oklch.css",
    "./brand-tokens.css": "./src/styles/brand-tokens.css",
    "./brand-tokens-oklch.css": "./src/styles/brand-tokens-oklch.css",
    "./brand-preset": "./src/styles/brand-preset.mjs",
    "./brand-theme-v4.css": "./src/styles/brand-theme-v4.css",
    "./brand-theme-v4-oklch.css": "./src/styles/brand-theme-v4-oklch.css",
    "./tokens.json": "./tokens.json",
    "./components.json": "./components.json"
  },
  "files": [
    "dist",
    "src",
    "tailwind-preset.ts",
    "tokens.json",
    "components.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
