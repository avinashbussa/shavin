{
  "name": "@shavin/cli",
  "version": "0.1.0",
  "description": "Sets up and checks projects that use @shavin/ui: init, add blocks, check, context, bridge, brand",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Avinash Bussa",
    "url": "https://avinashbussa.com"
  },
  "homepage": "https://docs.shavin.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avinashbussa/shavin.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/avinashbussa/shavin/issues"
  },
  "keywords": [
    "cli",
    "design-system",
    "scaffolding",
    "tailwind",
    "react",
    "nextjs",
    "ai-agents",
    "shavin"
  ],
  "type": "module",
  "main": "./src/index.mjs",
  "bin": {
    "shavin": "./bin/shavin.mjs",
    "shavin-cli": "./bin/shavin.mjs",
    "cli": "./bin/shavin.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./doctor": "./src/lib/doctor.mjs",
    "./render-check": "./src/lib/render-check.mjs",
    "./visual-check": "./src/lib/visual-check.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node ./bin/shavin.mjs",
    "bridge": "node ./bin/shavin.mjs bridge"
  },
  "dependencies": {
    "@shavin/block-schema": "^0.1.0"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "shavin": {
    "compat": {
      "@shavin/ui": ">=0.1.0 <0.2.0"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
